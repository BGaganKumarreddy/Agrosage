# ==============================================================================
# AgroSage Docker Compose Environment Variables
# Copy to .env before starting containers:
#   cp .env.docker.example .env
# ==============================================================================

# Published host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional Linux Container Master Key Encryption Key (KEK)
# When set, EnvKeyStore derives the KEK from this 256-bit secret for BYOK encryption.
# When left blank, FileKeyStore automatically generates and manages an owner-only (0600)
# keyfile within the persistent Docker volume (/app/data/storage/.keys/.kek_*).
# Example: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
AGROSAGE_MASTER_KEY=
