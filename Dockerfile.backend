# syntax=docker/dockerfile:1.7
# ==============================================================================
# AgroSage Backend — Production Multi-Stage Containerfile
# ==============================================================================

# Stage 1: Build virtual environment using Astral uv
FROM ghcr.io/astral-sh/uv:0.6.5-python3.12-bookworm-slim AS builder

WORKDIR /app

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Copy dependency specifications first for maximum Docker layer caching
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy application source and curated knowledge datasets
COPY src/ ./src/
COPY data/ ./data/

# Install the application package
RUN uv sync --frozen --no-dev

# Stage 2: Minimal runtime image
FROM python:3.12-slim-bookworm AS runtime

LABEL maintainer="AgroSage Engineering" \
      org.opencontainers.image.title="AgroSage Backend" \
      org.opencontainers.image.description="AgroSage Agricultural AI Advisory API"

WORKDIR /app

# Non-root user setup
RUN groupadd -g 10001 agrosage && \
    useradd -u 10001 -g agrosage -s /bin/sh -m agrosage

# Create persistent storage mount directory
RUN mkdir -p /app/data/storage && \
    chown -R agrosage:agrosage /app

# Copy virtual environment and source from builder
COPY --from=builder --chown=agrosage:agrosage /app/.venv /app/.venv
COPY --from=builder --chown=agrosage:agrosage /app/src /app/src
COPY --from=builder --chown=agrosage:agrosage /app/data /app/data

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AGROSAGE_AUTH_DB=/app/data/storage/auth.sqlite3 \
    AGROSAGE_HISTORY_DB=/app/data/storage/history.sqlite3 \
    AGROSAGE_KEYS_DIR=/app/data/storage/.keys

USER agrosage

EXPOSE 8000

# Zero-dependency standard library health probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health').read()"

CMD ["uvicorn", "agrosage.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
