# syntax=docker/dockerfile:1.7
# ==============================================================================
# AgroSage Frontend — Multi-Stage Production Containerfile
# ==============================================================================

# Stage 1: Build React SPA
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies using package-lock.json
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build arguments for Vite configuration
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Build production assets
RUN npm run build

# Stage 2: Serve with Nginx Alpine
FROM nginx:1.27-alpine-slim AS runtime

LABEL maintainer="AgroSage Engineering" \
      org.opencontainers.image.title="AgroSage Frontend" \
      org.opencontainers.image.description="AgroSage Agricultural AI Web Interface"

# Remove default nginx static assets and config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy compiled frontend from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy reverse proxy and security configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
